<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Verify Codes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f8f9fa;
    }
    .verify-container {
      max-width: 420px;
      width: 100%;
    }
    .email-edit, .phone-edit {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
      gap: 8px;
    }
    .email-edit a, .phone-edit a {
      color: #0d6efd;
      text-decoration: none;
    }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">

  <div class="verify-container bg-white p-4 rounded shadow text-center">
    <div class="mb-4">
      <img src="dddd.svg" alt="Logo" width="100" class="mb-2" />
      <h2 class="h5">Verify Your Contact Info</h2>
      <p class="text-muted small">Enter the codes sent to your email and WhatsApp number.</p>
    </div>

    <div class="email-edit">
  <span id="userEmail"><%= email %></span>
  <a href="/register" title="Edit Email">
    <i class="bi bi-pencil"></i>
  </a>
</div>

   <div class="phone-edit mb-3">
  <span id="userPhone">0<%= phone %></span>
  <a href="/register" title="Edit Phone">
    <i class="bi bi-pencil"></i>
  </a>
</div>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger" role="alert">
        <%= errorMessage %>
      </div>
    <% } %>

    <form action="/verify-both-codes" method="post">
      <div class="form-floating mb-3">
        <input type="text" class="form-control text-center" id="emailCode" name="emailCode" placeholder="123456" required maxlength="6" pattern="\d{6}">
        <label for="emailCode">Email Code</label>
      </div>

      <div class="form-floating mb-3">
        <input type="text" class="form-control text-center" id="phoneCode" name="phoneCode" placeholder="123456" required maxlength="6" pattern="\d{6}" disabled>
        <label for="phoneCode">WhatsApp Code</label>
      </div>

      <button type="submit" class="btn btn-primary w-100">Verify Both Codes</button>
    </form>

    <div class="text-center mt-3">
      <a href="/resend-codes" class="text-decoration-none">Resend codes</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
